# Copied to .env by `make start` (or `composer setup`). Only what this app
# needs: every other setting uses Laravel's default.

# make start fills in APP_KEY.
APP_NAME=GenStudio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
VITE_APP_NAME="${APP_NAME}"

# Postgres. In Docker it's also published on localhost:5433, for running the
# app on the host.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=genstudio
DB_USERNAME=app
DB_PASSWORD=secret

# Live updates (Reverb). In Docker the browser reaches it through /app on the
# page's own address; with `php artisan dev` it runs on localhost:8080.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=local
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Image provider: needed to show cost estimates and generate images.
IMAGE_PROVIDER_BASE_URL=
IMAGE_PROVIDER_API_KEY=
IMAGE_PROVIDER_WEBHOOK_SECRET=
IMAGE_PROVIDER_SIGNATURE_HEADER=
